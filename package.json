{
  "name": "tc-ai-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "mastra dev",
    "build": "MASTRA_BUILD_SKIP_INSTALL=true mastra build && node scripts/install-build-dependencies.mjs",
    "start": "mastra start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "studio": "mastra studio",
    "test:watch": "vitest",
    "deploy:dev": "BRANCH=$(git rev-parse --abbrev-ref HEAD) && TAG=\"dev-${BRANCH}\" && git tag -d \"$TAG\" 2>/dev/null; git push origin \":refs/tags/$TAG\" 2>/dev/null; git tag \"$TAG\" && git push origin \"$TAG\"",
    "ingest": "tsx --env-file=.env src/scripts/ingest-challenges.ts",
    "sync": "tsx --env-file=.env src/scripts/sync-challenges.ts",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs"
  },
  "keywords": [],
  "author": "Kiril Kartunov",
  "license": "ISC",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.207",
    "@ai-sdk/openai": "^3.0.135",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@mastra/ai-sdk": "^1.11.3",
    "@mastra/core": "^1.81.0",
    "@mastra/evals": "^1.10.10",
    "@mastra/libsql": "^1.28.0",
    "@mastra/loggers": "^1.3.10",
    "@mastra/memory": "^1.40.0",
    "@mastra/observability": "^1.23.0",
    "@mastra/pg": "^1.34.0",
    "@mastra/rag": "^2.7.1",
    "@mastra/server": "^1.81.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "ai": "^6.0.320",
    "ai-sdk-ollama": "^3.8.8",
    "csv-parse": "^7.0.3",
    "i18n-iso-countries": "^7.14.0",
    "js-tiktoken": "^1.0.21",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/58de37670180e183e8378c3d203df0112a0414f6",
    "turndown": "^7.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "mastra": "^1.37.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
