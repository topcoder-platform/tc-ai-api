  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "studio": "mastra studio",
    "test:watch": "vitest",
    "deploy:dev": "BRANCH=$(git rev-parse --abbrev-ref HEAD) && TAG=\"dev-${BRANCH}\" && git tag -d \"$TAG\" 2>/dev/null; git push origin \":refs/tags/$TAG\" 2>/dev/null; git tag \"$TAG\" && git push origin \"$TAG\"",
    "ingest": "tsx --env-file=.env src/scripts/ingest-challenges.ts",
    "sync": "tsx --env-file=.env src/scripts/sync-challenges.ts"
  },
  "keywords": [],
  "author": "Kiril Kartunov",
